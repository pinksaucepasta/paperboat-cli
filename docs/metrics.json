    {
      "name": "paperboat_runtime_update_operations_total",
      "kind": "counter",
      "labels": {
        "outcome": [
          "canceled",
          "failed",
          "success"
        ],
        "phase": [
          "activate",
          "download",
          "health_gate",
          "quarantine",
          "rollback",
          "stage",
          "verify"
        ]
      }
    },
    {
      "name": "paperboat_runtime_update_rollbacks_total",
      "kind": "counter"
    },
    {
      "name": "paperboat_runtime_watchdog_failures_total",
      "kind": "counter",
      "labels": {
        "reason": [
          "crash",
          "timeout",
          "unhealthy",
          "unknown"
        ]
      }
    }
  ]
}
