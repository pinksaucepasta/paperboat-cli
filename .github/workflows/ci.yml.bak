name: CI

on:
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.repository }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  quality:
    name: Fast repository quality contract
    runs-on: blacksmith-2vcpu-ubuntu-2404-arm
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: go.mod
          cache: true
      - name: Install repository check dependencies
        run: sudo apt-get update && sudo apt-get install -y ripgrep
      - name: Run non-duplicated quality checks
        run: >-
          make verify-toolchain contracts dependencies source-policy metrics-check
          hosted-image-check fmt-check generate-check tidy-check vet build

  race:
    name: Linux race detector
    runs-on: blacksmith-2vcpu-ubuntu-2404-arm
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: go.mod
          cache: true
      - run: make race

  supply-chain:
    name: Vulnerability and license checks
    runs-on: blacksmith-2vcpu-ubuntu-2404-arm
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: go.mod
          cache: true
      - name: Run independent supply-chain gates in parallel
        shell: bash
        run: |
          set -euo pipefail
          make vulnerability-check & vulnerability_pid=$!
          make license-check & license_pid=$!
          status=0
          wait "$vulnerability_pid" || status=1
          wait "$license_pid" || status=1
          exit "$status"
