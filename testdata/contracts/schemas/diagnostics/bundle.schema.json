{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.paperboat.dev/diagnostics/bundle.schema.json",
  "title": "Paperboat diagnostic bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "correlation", "created_at", "path", "bytes", "categories"],
  "properties": {
    "schema": { "const": "paperboat.diagnostic-bundle/v1" },
    "correlation": { "type": "string", "pattern": "^pb-[a-f0-9]{32}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "bytes": { "type": "integer", "minimum": 1, "maximum": 26214400 },
    "categories": {
      "type": "array",
      "prefixItems": [{ "const": "manifest" }, { "const": "recent_events" }, { "const": "redacted_events" }, { "const": "status" }],
      "minItems": 4,
      "maxItems": 4
    }
  }
}
