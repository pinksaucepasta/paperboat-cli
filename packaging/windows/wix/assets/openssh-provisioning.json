{
  "schema": "paperboat.windows.openssh-packaging-hook/v1",
  "package_id": "Microsoft.OpenSSH.Preview",
  "approved_version": "10.0.0.0",
  "installer": "winget",
  "install_arguments": [
    "install",
    "--exact",
    "--id",
    "Microsoft.OpenSSH.Preview",
    "--version",
    "10.0.0.0",
    "--source",
    "winget",
    "--scope",
    "machine",
    "--silent",
    "--accept-source-agreements",
    "--accept-package-agreements"
  ],
  "required_parts": [
    "OpenSSH Client",
    "OpenSSH Server"
  ],
  "service": "PaperboatSshd",
  "state_root": "C:\\ProgramData\\Paperboat\\ssh",
  "bind_addresses": [
    "127.0.0.1",
    "::1"
  ],
  "capability_installation": "never",
  "existing_system_sshd": "preserve",
  "runtime_owner": "Paperboat host setup"
}
