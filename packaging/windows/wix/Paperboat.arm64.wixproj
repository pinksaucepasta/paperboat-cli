<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>arm64</Platform>
    <PaperboatArchitecture>arm64</PaperboatArchitecture>
    <PaperboatChannel>beta</PaperboatChannel>
    <OutputName>paperboat-$(PaperboatVersion)-windows-arm64</OutputName>
    <DefineConstants>WixPlatform=arm64;PaperboatChannel=beta;PaperboatVersion=$(PaperboatVersion);PaperboatMSIVersion=$(PaperboatMSIVersion);StagingDir=$(StagingDir);PackagingRoot=$(MSBuildProjectDirectory)\..</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Paperboat.wxs" />
  </ItemGroup>
</Project>
